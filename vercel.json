{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "defitnesscoach.nl" }],
      "destination": "https://www.defitnesscoach.nl/:path*",
      "permanent": true
    },
    {
      "source": "/receptenboek",
      "destination": "https://info.defitnesscoach.nl/receptenboek",
      "permanent": false
    },
    {
      "source": "/receptenboek/:path*",
      "destination": "https://info.defitnesscoach.nl/receptenboek/:path*",
      "permanent": false
    },
    {
      "source": "/coaching",
      "destination": "https://info.defitnesscoach.nl/coaching",
      "permanent": false
    },
    {
      "source": "/coaching/:path*",
      "destination": "https://info.defitnesscoach.nl/coaching/:path*",
      "permanent": false
    }
  ]
}
